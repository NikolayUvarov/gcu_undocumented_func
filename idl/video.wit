/// Video gateway (issue 158): the cameras and their frames. `init` gives the gateway's only client to the shell, which
/// lends it in SLOT_CAMERA to a program that asks for REQUEST_CAMERA once the user agreed (MC-11.4). A camera has one
/// owner at a time; while any stream is open the compositor shows a camera mark that no program can hide. Pixels are
/// 0x00RRGGBB, row after row, as on a screen. Without a camera the gateway lists none, unless the boot disk holds
/// `video/synthetic`: then a moving test pattern stands in (the tests' source, as the WAV files are for voice).
package mind:video@1.0.0;

interface video {
    enum error { not-found, busy, invalid, not-open, no-memory }
    /// A camera: its name, the largest picture and rate it gives, and whether it is the synthetic test source.
    record camera { name: string<24>, width: u16, height: u16, rate: u8, synthetic: bool }
    /// A frame: its number since the stream opened (from 1), when it was taken (monotonic clock, µs), its size and the
    /// bytes copied into the lent buffer.
    record frame { sequence: u32, timestamp-us: u64, width: u16, height: u16, bytes: u32 }

    /// The cameras, in the order `open` numbers them.
    cameras: func() -> list<camera, 4>;
    /// Opens camera `camera` at `width` × `height` and `rate` frames a second and makes the caller its owner; busy
    /// while another task owns it (a stream whose owner ended can be taken over); invalid for a size or rate it lacks.
    open: func(camera: u8, width: u16, height: u16, rate: u8) -> result<_, error>;
    /// The next frame of the caller's stream into the lent buffer (at most `capacity` bytes); waits until it is due.
    /// Returns its sequence number.
    read: func(capacity: u32, pixels: borrow<memory>) -> result<u32, error>;
    /// The frame `read` copied last.
    frame: func() -> result<frame, error>;
    /// Closes the caller's stream.
    close: func() -> result<_, error>;
}
