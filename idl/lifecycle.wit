/// Lifecycle of boot services and applications, served by `init` (the lifecycle owner, roadmap C6): which services
/// run, starting, stopping and restarting them, stopping an application. A client is init's endpoint; the shell
/// holds one and lends it to programs that ask for lifecycle control (`REQUEST_LIFECYCLE`: `svc`, `top`). `init`
/// itself and the shell cannot be stopped. Restart budgets, generations and failure notification come with C6.
package mind:lifecycle@1.0.0;

interface lifecycle {
    /// Why a request failed: no such service or task, it already runs (start) or does not (stop), it may not be
    /// stopped, its device is missing, or the spawn failed.
    enum error { not-found, running, stopped, denied, no-device, failed }

    /// A boot service: its PID (0 if it does not run), how often init started it, whether it runs, what it holds.
    record service { name: string<16>, pid: u64, starts: u32, running: bool, holds: string<48> }

    /// The boot services in boot order.
    list: func(buffer: borrow<memory>) -> result<list<service, 24>, error>;
    /// Starts a service that does not run; returns its PID.
    start: func(buffer: borrow<memory>, name: string<16>) -> result<u64, error>;
    /// Stops a running service; its clients' calls fail with ERR_PEER until it is started again.
    stop: func(buffer: borrow<memory>, name: string<16>) -> result<_, error>;
    /// Stops and starts a service; clients granted earlier reach the new instance. Returns its PID.
    restart: func(buffer: borrow<memory>, name: string<16>) -> result<u64, error>;
    /// Stops an application (a task that is not a boot service).
    stop-task: func(pid: u64) -> result<_, error>;
}
