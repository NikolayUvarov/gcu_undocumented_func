/// Parser service (`parse`, 109-NET-0008, MC-11.11, Appendix B.6): turns bounded bytes from outside into typed messages,
/// so the program that holds the network and the files does not parse them itself. It holds nothing but its own
/// endpoint and the system log: no files, no network, no spawn, no devices. Each request is parsed on its own; nothing
/// of one stays for the next. A refusal is logged with the client's PID. The client still checks what a typed message
/// says against what it asked for (MC-11.5). 2.0 (000-NET-0047): one HTTP response head, `http-response`, which also
/// gives the content coding, the media type, `Location` and `Retry-After`; 1.x's `http-head` is gone. 2.1 (110-NET-0070):
/// `http-request`, a request head as a server reads it. 3.0 (351-UPD-0026): a channel's signatures name their keys, one
/// to 8 of them; `keys`, a key file; 2.x's channel with one signature is gone. 4.0 (351-UPD-0027): a key file's roles take `root`, the keys
/// that sign the next one; 3.x's key file of four roles is gone. 4.1 (351-UPD-0028): `timestamp`, a channel's timestamp file.
/// 4.2 (351-UPD-0030): `order`, a recovery order. 5.0 (801-NET-0080): `http-response` also gives the server's `Date`;
/// 4.x's response without it is gone.
package mind:parse@5.0.0;

interface parse {
    /// Why a request failed: `malformed`, the bytes are not of the form asked for.
    enum error { malformed }

    /// An architecture's boot manifest in a channel: its name and the manifest's SHA-256 (1.1, 351-NET-0011).
    record manifest-ref { arch: string<16>, digest: list<u8, 32> }
    /// A signature line of a channel or a key file: the public key it names and the Ed25519 signature (3.0).
    record signature { key: list<u8, 32>, value: list<u8, 64> }
    /// A release channel file (docs/update/publishing.md), read in its one encoding (`mind::release`): its fields; the
    /// signatures cover the file's first `signed` bytes, in the file's order. The updater accepts the fields only if
    /// they encode again to exactly those bytes, and counts the signatures itself.
    record channel { name: string<32>, version: u64, minimum: u64, expires: string<20>, manifests: list<manifest-ref, 4>, signed: u32, signatures: list<signature, 8> }
    /// A public key of a key file's role (3.0).
    record public-key { key: list<u8, 32> }
    /// A role of a key file: its public keys in ascending order and how many must sign (3.0).
    record role { keys: list<public-key, 4>, threshold: u8 }
    /// A key file (351-UPD-0026): its version, its expiry and the roles boot, recovery, release, root and timestamp in
    /// that order; the root keys' signatures cover its first `signed` bytes. Taken as a channel is (3.0; 4.0: `root`).
    record key-file { version: u64, expires: string<20>, roles: list<role, 5>, signed: u32, signatures: list<signature, 8> }
    /// A channel's timestamp file (351-UPD-0028): the channel, its file's SHA-256, a short expiry and the timestamp's own
    /// version; the timestamp keys' signatures cover its first `signed` bytes. Taken as a channel is (4.1).
    record timestamp { channel: string<32>, digest: list<u8, 32>, expires: string<20>, version: u64, signed: u32, signatures: list<signature, 8> }
    /// A recovery order (351-UPD-0030): the channel, its expiry, the floor it lowers to, its sequence and the version to
    /// go back to; the recovery keys' signatures cover its first `signed` bytes. Taken as a channel is (4.2).
    record recovery-order { channel: string<32>, expires: string<20>, floor: u64, sequence: u64, version: u64, signed: u32, signatures: list<signature, 8> }
    /// A file line of a boot manifest.
    record file { path: string<96>, size: u64, digest: list<u8, 32>, flags: u32, mib: u32 }
    /// A boot manifest's header lines (its format line first, as text), its number of file lines, and up to 8 of them
    /// from the one asked for (a reply small enough for a program's 64 KiB stack).
    record manifest { headers: list<string<128>, 8>, files: u32, page: list<file, 8> }

    /// A channel file (1.1; 3.0: its signatures with their keys, up to 2560 bytes).
    channel: func(file: bytes<2560>) -> result<channel, error>;
    /// A key file (3.0; 4.0: five roles).
    keys: func(file: bytes<4096>) -> result<key-file, error>;
    /// A timestamp file (4.1).
    timestamp: func(file: bytes<2048>) -> result<timestamp, error>;
    /// A recovery order (4.2).
    order: func(file: bytes<2048>) -> result<recovery-order, error>;
    /// A boot manifest of format 1, checked whole, and its file lines from `start` (1.1).
    manifest: func(text: bytes<32768>, start: u32) -> result<manifest, error>;

    /// A file of a model on a model disk: its path below the model's directory, its size and SHA-256 (1.2, 251-STO-0014).
    record model-file { path: string<96>, size: u64, sha256: list<u8, 32> }
    /// One model of a model disk's MANIFEST.json (`mind::models`): how many models the manifest lists, the model's id,
    /// where its entry lies in the text (`entry-start`, `entry-length`), its number of files and up to 8 of them from
    /// the one asked for.
    record model { models: u32, id: string<64>, entry-start: u32, entry-length: u32, files: u32, page: list<model-file, 8> }

    /// Model `index` of a model disk's MANIFEST.json, read whole, and its files from `start` (1.2).
    model: func(text: bytes<60000>, index: u32, start: u32) -> result<model, error>;

    /// A body's content coding: one of identity, gzip and deflate, or `other` (not decoded) (2.0).
    enum content-coding { identity, gzip, deflate, other }
    /// What `Retry-After` says: nothing valid, a number of seconds, or a date (seconds since 1970-01-01 UTC) (2.0).
    enum retry-kind { none, seconds, date }
    /// An HTTP/1.x response head. `length` is `Content-Length` when `has-length`. When `has-range`, `Content-Range` is
    /// bytes `range-start` to `range-end` (inclusive) of `range-total`, or nothing of `range-total` when
    /// `range-unsatisfied` (`bytes */total`). `chunked`: a transfer coding other than identity. `close`: whether the
    /// connection ends after the response (`Connection: close`, or HTTP/1.0 without `keep-alive`) (1.3, 750-NET-0019).
    /// 2.0 (000-NET-0047): `encoding` (`Content-Encoding`), `media` (`Content-Type`'s media type in lower case, without
    /// parameters), `location` as the server wrote it, and `retry` with `retry-after`. 5.0 (801-NET-0080): `date`, the
    /// server's `Date` as seconds since 1970-01-01 UTC, when `has-date` (a valid HTTP-date).
    record http-response {
        status: u16, has-length: bool, length: u64, has-range: bool, range-unsatisfied: bool, range-start: u64, range-end: u64, range-total: u64, chunked: bool, close: bool,
        encoding: content-coding, media: string<64>, location: string<1024>, retry: retry-kind, retry-after: u64, has-date: bool, date: u64,
    }
    /// The head of an HTTP response: its status line and header lines, without the blank line that ends them.
    http-response: func(head: bytes<8192>) -> result<http-response, error>;

    /// 1.4 (750-NET-0021): a JSON text (RFC 8259, UTF-8) read whole with `mind::json`, within its bounds: at most 1024
    /// values, nesting 16 deep, a key 64 bytes and a string 512 bytes once decoded; anything else is malformed. Its values
    /// in document order, 16 from `start` (a page fits a program's stack beside its own buffers): each with its kind, the index of the object or array it is in (65535 for the
    /// outermost), its member's key (empty in an array), and for a string its text, for a number its lexeme as written.
    /// The client still checks the tree against what it expects (MC-11.5); a key that comes twice is the client's to
    /// refuse.
    enum json-kind { object, array, string, number, true, false, null }
    record json-value { kind: json-kind, parent: u16, key: string<64>, text: string<512> }
    record json-page { values: u32, page: list<json-value, 16> }
    json: func(text: bytes<16384>, start: u32) -> result<json-page, error>;

    /// 2.1 (110-NET-0070): an HTTP/1.x request head as a server reads it (`mind::http_serve::parse_request`, the rules
    /// of `tools/httpd`): GET or HEAD, HTTP/1.1 or 1.0, `Host` for 1.1, no folded line, at most 64 header lines, a
    /// target of at most 1024 bytes. `refusal`: why it is not served, `none` when it is; the server answers 400, 405,
    /// 505, 400, 431 or 414 for the others. Of a head served: the method, the target as sent, whether it is HTTP/1.1,
    /// whether the connection stays open after the response, the first `Range` and `If-None-Match` values (empty: none,
    /// or longer than 128 bytes), and whether a body follows (a first `Content-Length` other than 0, or a transfer coding).
    enum http-refusal { none, malformed, method, version, no-host, too-many-headers, too-long }
    enum http-method { get, head }
    record http-request { refusal: http-refusal, method: http-method, target: string<1024>, http11: bool, keep-alive: bool, range: string<128>, if-none-match: string<128>, body: bool }
    /// The head of an HTTP request: its request line and header lines, with or without the blank line that ends them.
    http-request: func(head: bytes<8192>) -> result<http-request, error>;
}
