/// Network stack (`netstack`): IPv4 over the network card driver, with DHCP, ICMP echo, a DNS resolver, UDP and TCP.
/// Addresses are IPv4 in a u32 (a.b.c.d is a << 24 | b << 16 | c << 8 | d). A socket handle belongs to the client that
/// opened it (PID and endpoint badge); a client has at most 8 sockets, the stack 32, each with bounded buffers.
/// Calls that wait for the network (`ping`, `resolve`, `tcp-connect`) are answered later, when the answer arrives or
/// the timeout passes; the other calls never block (error `again`: try later).
///
/// What a client may do comes from the badge of its endpoint capability (issue 102): the operator's badge (the shell)
/// may do anything; a flow grant's badge only what the policy broker registered for it (`policy-set`: destinations,
/// protocols, a term and a volume), and is refused (`denied`) otherwise; the policy badge registers grants (and, since 2.3,
/// looks up the names a policy gives, `resolve`); an
/// unbadged client is refused. Major version 2: `denied` and the badge rules change what 1.0 calls may answer.
///
/// Several cards (issue 105, 2.1): each card driver is one interface with its own configuration (DHCP per card). A flow
/// goes out through the interface whose network holds the destination, otherwise through the first interface with a
/// gateway; `config` describes that default interface, `interfaces` all of them.
///
/// 2.2 (issue 106): `offload` turns transmit checksum offload on or off for every card that offers it (operator only).
///
/// 2.3 (351-NET-0003): the policy badge may `resolve`, for the host names of the policy file.
package mind:socket@2.3.0;

interface socket {
    /// Why a request failed.
    enum error { no-network, no-socket, closed, again, refused, timeout, invalid, limit, unreachable, not-found, denied }

    /// A protocol a rule allows.
    enum protocol { tcp, udp, icmp }

    /// One destination a grant may reach: an address (never 0), a port (0: any; ICMP has none) and a protocol.
    record rule { address: u32, port: u16, protocol: protocol }

    /// A network interface: its card (0: the first driver instance), configuration (address 0: not configured yet),
    /// MAC address and the frames it sent and received.
    record interface { card: u8, address: u32, prefix: u8, gateway: u32, dns: u32, mac: u64, dhcp: bool, sent: u64, received: u64 }

    /// What a grant used: bytes sent and received, sockets open, milliseconds left (0: expired).
    record usage { sent: u64, received: u64, sockets: u32, left-ms: u32 }

    /// The interface: address and prefix length, gateway and DNS server (0: none), MAC address, whether DHCP
    /// configured it (or the static fallback did).
    record config { address: u32, prefix: u8, gateway: u32, dns: u32, mac: u64, dhcp: bool }

    /// A UDP datagram and where it came from.
    record datagram { address: u32, port: u16, data: list<u8, 1472> }

    config: func() -> result<config, error>;
    /// ICMP echo to `address`; returns the round trip in microseconds.
    ping: func(address: u32, timeout-ms: u32) -> result<u32, error>;
    /// IPv4 address of `name` from DNS server `server` (0: the configured one) on `port` (0: 53).
    resolve: func(name: string<253>, server: u32, port: u16, timeout-ms: u32) -> result<u32, error>;
    /// A UDP socket on local `port` (0: any free port).
    udp-open: func(port: u16) -> result<u32, error>;
    udp-send: func(socket: u32, address: u32, port: u16, data: bytes<1472>) -> result<_, error>;
    /// The oldest datagram received on the socket. Error again: none is waiting.
    udp-receive: func(socket: u32) -> result<datagram, error>;
    /// A TCP connection to `address` and `port`, answered once it is established (or refused, or timed out).
    tcp-connect: func(address: u32, port: u16, timeout-ms: u32) -> result<u32, error>;
    /// Queues data; returns how many bytes were taken (0 with a full send buffer).
    tcp-send: func(socket: u32, data: bytes<4096>) -> result<u32, error>;
    /// Up to `length` received bytes. Error again: nothing yet; closed: the peer closed and everything was read.
    tcp-receive: func(socket: u32, length: u32) -> result<bytes<4096>, error>;
    /// Closes a socket (TCP: after the queued data is sent) and frees its handle.
    close: func(socket: u32) -> result<_, error>;
    /// Registers what clients with `badge` may reach, for `seconds`, up to `bytes` in both directions (policy badge only).
    policy-set: func(badge: u16, rules: list<rule, 16>, seconds: u32, bytes: u64) -> result<_, error>;
    /// Drops a grant: its sockets are closed and further requests with its badge are refused (policy badge only).
    policy-drop: func(badge: u16) -> result<u32, error>;
    /// What a grant has used (policy badge only).
    policy-usage: func(badge: u16) -> result<usage, error>;
    /// Every interface whose card driver answered (2.1).
    interfaces: func() -> result<list<interface, 4>, error>;
    /// Turns transmit checksum offload on or off (operator only, 2.2); returns the cards that use it now (bit n: card n).
    offload: func(enable: bool) -> result<u32, error>;
}
