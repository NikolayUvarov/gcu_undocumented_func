/// System information from `sysmon` (MC-10.2): the kernel's STAT records and a history of load samples. Clients get
/// an endpoint from the shell at launch (SLOT_SYSINFO); `sysmon` holds the observe privilege and limits each client's
/// request rate. 2.0: the fields of STAT version 2 (issues 075, 076) at the end of the records; 2.1: `holders`; 3.0:
/// `authority`, and who holds what needs the authority badge (issue 081); 4.0: `tasks`, `endpoints` and `caps` from a
/// position on, since the kernel has no fixed count of them, `cpus` too, and a sample with the busy share of every CPU in
/// its mean and maximum (171-APP-0002, 171-APP-0007).
///
/// Who holds what is the authority graph (MC-3.4–3.6): `authority` and `holders` answer only a client whose capability
/// carries the authority badge (`mind::stat::BADGE_AUTHORITY`, the shell's SLOT_AUTHORITY client, lent to programs
/// that ask for `REQUEST_AUTHORITY`); other clients get `denied`, and `caps` gives them no derivation links (`node`
/// and `parent` are 0).
package mind:sysinfo@4.0.0;

interface sysinfo {
    /// Why a request failed.
    enum error { busy, not-found, unavailable, denied }

    /// A task (StatTask). `wait` is WAIT_* and `wait-on` the endpoint index, IRQ line or server PID it waits for;
    /// `flags`: `mind::stat::TASK_SERVICE`, `TASK_SCREEN`, `TASK_FOCUS`; `kernel`: its context, mailbox, info and exit
    /// pages and page tables.
    record task {
        pid: u64, parent: u64, run-ns: u64, runs: u64, ticks: u64, calls: u64, sends: u64, receives: u64, started-ns: u64,
        image: u64, stack: u64, screen: u64, heap: u64, shared: u64, retained: u64, budget-ns: u64, period-ns: u64,
        wait-on: u32, heap-blocks: u32, caps: u32, quota-tasks: u16, used-tasks: u16, quota-endpoints: u16, used-endpoints: u16,
        name: string<16>, wait: u8, cpu: u8, flags: u8, band: u8, throttled: bool, kernel: u64,
    }
    /// A CPU (StatCpu).
    record cpu { busy-ns: u64, idle-ns: u64, ticks: u64, switches: u64, interrupts: u64, current: u64, apic: u32, online: bool }
    /// Kernel memory by use (StatMemory, bytes): `largest-free` is the largest block the arena can still allocate,
    /// `shared` memory of other owners mapped by tasks; the kernel's task and endpoint limits (the root quota, 65 535; issue 171).
    record memory {
        arena: u64, used: u64, free: u64, images: u64, stacks: u64, task-pages: u64, screens: u64, heaps: u64,
        objects: u64, objects-limit: u64, dma: u64, dma-limit: u64, tasks: u32, endpoints: u32,
        largest-free: u64, page-tables: u64, shared: u64, tasks-limit: u32, endpoints-limit: u32,
    }
    /// A physical range (StatPhys): UEFI memory type, or the platform layout from PHYS_PLATFORM on.
    record range { start: u64, pages: u64, kind: u32, index: u32 }
    /// A region of an address space (StatRegion: REGION_* kind and flags).
    record region { start: u64, size: u64, kind: u32, flags: u32 }
    /// A capability of a task (StatCap: no physical addresses; ports give their base and an IRQ its line in `rights`;
    /// `endpoint` is the endpoint index of an endpoint capability).
    record capability { node: u64, parent: u64, size: u64, slot: u32, generation: u32, kind: u32, rights: u32, badge: u32, endpoint: u32 }
    /// An endpoint (StatEndpoint: the index is a label, not an authority): its server, how many tasks hold it, the IRQ
    /// line bound to it (0: none).
    record endpoint-info { messages: u64, busy: u64, timeouts: u64, creator: u64, index: u32, receivers: u32, senders: u32, receiving: u32, server: u64, holders: u32, irq: u32 }
    /// An interrupt line (StatIrq): the holder is the task that uses it (a driver rather than init); `holders` counts
    /// the tasks holding a copy.
    record irq { count: u64, holder: u64, line: u32, endpoint: u32, masked: bool, holders: u32 }
    /// A PCI function (StatDevice): BAR sizes, class, IRQ, the task holding it, `location` (bus << 8 | device << 3 |
    /// function), `io-bars` (bit i: BAR i is a port range).
    record device { bar0: u64, bar1: u64, bar2: u64, bar3: u64, bar4: u64, bar5: u64, holder: u64, class: u32, irq: u32, location: u32, io-bars: u32 }
    /// A task holding a capability for an endpoint: its slot, rights (CAP_*) and badge.
    record holder { pid: u64, slot: u32, rights: u32, badge: u32 }
    /// A capability of some task with its derivation links (3.0): `node` is its derivation node, `parent` the node it
    /// was derived from (0: a root); revoking a capability removes the subtree below its node.
    record authority-entry { node: u64, parent: u64, pid: u64, size: u64, slot: u32, generation: u32, kind: u32, rights: u32, badge: u32, endpoint: u32 }
    /// One sample of the load history: busy per mille of CPUs 0..15 (as many as are online; a graph each is what one
    /// screen holds), the mean over every online CPU and the busiest one, and counts during the interval.
    record sample { busy: list<u16, 16>, busy-total: u16, busy-max: u16, interrupts: u32, syscalls: u32, messages: u32, switches: u32, used-kib: u32, tasks: u32, runnable: u32 }
    /// Load averages (runnable tasks x 100) over 1, 5 and 15 minutes, uptime and sampling periods.
    record load { one: u32, five: u32, fifteen: u32, uptime-ms: u64, fast-ms: u32, slow-ms: u32, fast-count: u32, slow-count: u32 }

    /// The tasks from position `start` on, at most 40 (call again with a larger `start` for the rest).
    tasks: func(start: u32) -> result<list<task, 40>, error>;
    /// The CPUs from position `start` on, at most 64 (the kernel starts up to 256).
    cpus: func(start: u32) -> result<list<cpu, 64>, error>;
    memory: func() -> result<memory, error>;
    physmap: func() -> result<list<range, 256>, error>;
    /// Address space of task `pid`.
    vmap: func(pid: u64) -> result<list<region, 80>, error>;
    /// Capabilities of task `pid` from position `start` on, at most 64 (a table grows to 4095).
    caps: func(pid: u64, start: u32) -> result<list<capability, 64>, error>;
    /// The endpoints from position `start` on, at most 128 (call again with a larger `start` for the rest).
    endpoints: func(start: u32) -> result<list<endpoint-info, 128>, error>;
    irqs: func() -> result<list<irq, 16>, error>;
    devices: func() -> result<list<device, 64>, error>;
    /// The last `count` samples, oldest first: every 100 ms (`slow` false, up to 300) or every second (up to 600); a reply
    /// holds those from position `start` on, at most 150 (call again with a larger `start` for the rest).
    history: func(slow: bool, count: u16, start: u16) -> result<list<sample, 150>, error>;
    load: func() -> result<load, error>;
    /// The tasks holding a capability for endpoint `index` (2.1); error not-found for an index no endpoint has. Needs
    /// the authority badge (3.0).
    holders: func(index: u32) -> result<list<holder, 64>, error>;
    /// The capabilities of all tasks in PID and slot order, from entry `start` on, at most 128 (call again with a larger
    /// `start` for the rest); needs the authority badge (3.0).
    authority: func(start: u32) -> result<list<authority-entry, 128>, error>;
}
