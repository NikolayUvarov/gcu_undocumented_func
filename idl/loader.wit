/// Program loader: lists and starts application programs from the boot disk. A launch with capabilities is a session
/// (1.1): the caller names the program, lends the capabilities it decides to give (MC-3.11: the program only requests
/// them, see `inspect`), then commits.
package mind:loader@1.9.0;

interface loader {
    /// Why a launch session failed; `unreadable` (1.7): the program's file could not be read, its drive does not answer.
    enum error { not-found, invalid, no-memory, limit, busy, rights, sessions, unreadable }
    /// A program file in the root of the boot disk.
    record program {
        name: string<16>,
        size: u64,
        service: bool,
    }
    /// What a program asks its launcher for (`mind::request!`, read from its ELF). It grants nothing.
    record needs { console: bool, sysinfo: bool, file: bool, lifecycle: bool, log: bool, files: bool }
    /// The `*.elf` programs in the root of the boot disk (at most 128, 1.4: 64 before); services are marked.
    list: func() -> list<program, 128>;
    /// Starts program `name` (a name, or a path with `.` or `/`) with `args` in its info page; returns its PID.
    run: func(name: string<64>, args: string<1024>) -> result<u64, error-code>;
    /// Starts a launch of `name` (a program on the boot disk) with `args`; returns the session (1.1).
    begin: func(name: string<64>, args: string<1024>) -> result<u32, error>;
    /// Gives the new program a copy of `cap` in its fixed slot `slot` (SLOT_FILE, SLOT_INIT for a ping/pong pair,
    /// SLOT_SYSINFO, SLOT_LIFECYCLE, SLOT_LOG) (1.1).
    grant: func(session: u32, slot: u8, cap: borrow<endpoint>) -> result<_, error>;
    /// Starts the program (with a screen unless it asked to be a console program); returns its PID (1.1).
    commit: func(session: u32) -> result<u64, error>;
    /// Drops a session and the capabilities granted to it (1.1).
    abort: func(session: u32) -> result<_, error>;
    /// What the program `name` requests (1.1).
    inspect: func(name: string<64>) -> result<needs, error>;
    /// The raw request flags of `name` (`mind::process::REQUEST_*`), including flags `needs` has no field for (1.2).
    inspect-requests: func(name: string<64>) -> result<u32, error>;
    /// Gives the new program a copy of read-only memory `cap` in its fixed slot `slot`: only SLOT_DISPLAY, where a
    /// window manager lends the surface of the window to record (issue u014); a writable one is refused (1.3).
    grant-memory: func(session: u32, slot: u8, cap: borrow<memory>) -> result<_, error>;
    /// `commit` in front: the caller must have the focus now; the program takes it and gives it back when it ends.
    /// `rights` when the caller is not in front: nothing starts and the session stays open for `commit`. A console
    /// program starts as with `commit` (issue 160, 1.5).
    commit-in-front: func(session: u32) -> result<u64, error>;
    /// Gives the new program a copy of the firmware variable privilege `cap` in SLOT_FIRMWARE, where a launcher lends
    /// it with the user's consent for REQUEST_FIRMWARE (351-KRN-0027, 1.6).
    grant-firmware: func(session: u32, cap: borrow<firmware>) -> result<_, error>;
    /// A helper program the loader starts for its caller (1.8): `parse`, the parser of 109-NET-0010.
    enum helper-kind { parse }
    /// Starts helper `which` for the caller (1.8, 109-KRN-0096). It gets nothing but a copy of `served`, an endpoint
    /// that must carry the right to receive, in its SLOT_INIT: no standard clients, no screen, no log, no tasks or
    /// endpoints of its own, 2 MiB of memory. It serves that endpoint alone and ends when told or left idle; a caller
    /// may have 4 at once (`limit`). Returns its PID.
    helper: func(which: helper-kind, served: borrow<endpoint>) -> result<u64, error>;
    /// `commit`, or with `front` `commit-in-front`, the program started with a text input (1.9, 000-KRN-0094): returns
    /// the writer of that input (`mind::io::Writer`), whose `CAP_INFO` names the program's PID. The program reads it with
    /// `mind::io` to its end, which comes when the writer closes it or no copy of the writer is left.
    commit-with-input: func(session: u32, front: bool) -> result<own<text>, error>;
}
