/// Program loader: lists and starts application programs from the boot disk (MIND IDL v0.2, buffer calls).
package mind:loader@1.0.0;

interface loader {
    /// A program file in the root of the boot disk.
    record program {
        name: string<16>,
        size: u64,
        service: bool,
    }
    /// The `*.elf` programs in the root of the boot disk (at most 64); services are marked.
    list: func() -> list<program, 64>;
    /// Starts program `name` (a name, or a path with `.` or `/`) with `args` in its info page; returns its PID.
    run: func(name: string<64>, args: string<1024>) -> result<u64, error-code>;
}
