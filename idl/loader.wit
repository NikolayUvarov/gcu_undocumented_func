/// Program loader: starts applications from the boot disk. A launch is a session: the caller names the program, lends
/// the capabilities it decides to give (MC-3.11: the program only requests them, see `inspect`), then commits.
package mind:loader@2.0.0;

interface loader {
    /// Why a request failed.
    enum error { not-found, invalid, no-memory, limit, busy, rights, sessions }

    /// What a program asks its launcher for (`mind::request!`, read from its ELF). It grants nothing.
    record needs { console: bool, sysinfo: bool, file: bool, lifecycle: bool, log: bool, files: bool }

    /// Starts a launch of `name` (a program on the boot disk) with `args`; returns the session.
    begin: func(buffer: borrow<memory>, name: string<64>, args: string<1024>) -> result<u32, error>;
    /// Gives the new program a copy of `cap` in its slot `slot` (7..12; 12, the system log, since 1.1).
    grant: func(session: u32, slot: u8, cap: borrow<endpoint>) -> result<_, error>;
    /// Starts the program (with a screen unless it asked to be a console program); returns its PID.
    commit: func(session: u32) -> result<u64, error>;
    /// Drops a session and the capabilities granted to it.
    abort: func(session: u32) -> result<_, error>;
    /// What the program `name` requests.
    inspect: func(buffer: borrow<memory>, name: string<64>) -> result<needs, error>;
}
