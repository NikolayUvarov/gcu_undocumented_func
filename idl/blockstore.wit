/// Block store (`blockstore`, issue 300-STO-0002, docs/storage): immutable blocks named by their content identifier
/// (CIDv1, `raw`, SHA-256; 36 bytes in binary form). Nothing stored is overwritten, and a block is checked against its
/// CID before it is returned: a block whose bytes do not match is reported corrupt, never returned (MC-4.2, 4.8).
package mind:blockstore@1.0.0;

interface blockstore {
    /// Why a request failed. `rights` is reserved for the badges of 300-STO-0004.
    enum error { not-found, corrupt, full, too-large, read-only, device, unsupported, rights }

    /// Intact blocks and their bytes; sectors of the log and of the medium; records found corrupt and non-blank
    /// sectors outside every record; how many blocks the index can hold.
    record stats { blocks: u32, bytes: u64, used: u64, sectors: u64, corrupt: u32, damaged: u64, capacity: u32 }

    /// Stores `data` as a raw block and returns its CID once the medium has flushed it; bytes already stored are not
    /// written again. Errors: too-large, full (medium or index), read-only, device.
    put: func(data: bytes<16384>) -> result<bytes<36>, error>;
    /// The block `cid` names, only if its bytes match it. Errors: unsupported (not a supported CID), not-found,
    /// corrupt (the block also leaves the index, so a put of the same bytes stores them again), device.
    get: func(cid: bytes<36>) -> result<bytes<16384>, error>;
    /// Whether the index holds `cid`; the block is not read. Error: unsupported.
    has: func(cid: bytes<36>) -> result<bool, error>;
    stat: func() -> stats;
}
