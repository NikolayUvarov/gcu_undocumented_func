/// Block devices with 512-byte sectors: drivers serve it, vfs_server is the client (MIND IDL, word calls). A client may
/// be bounded to a window of the device's sectors (1.2, 307-DRV-0054): its badge names the window in bits 1 to 3
/// (`mind::block::BADGE_WINDOW`; 0 is the whole device), and it sees the window as the device: `sectors` is the
/// window's count, and `read` and `write` take sectors from the window's first, clipped at its end. Until the window is
/// set, after a driver's restart too, every call of its client is not-found, never the whole device. A drive that fails
/// or does not answer is io (1.3, 000-KRN-0228), never peer: a client repeats a call only after peer or not-found, which
/// a restarted driver answers.
package mind:block@1.3.0;

interface block {
    /// Number of sectors; error not-found without a drive.
    sectors: func() -> result<u64, error-code>;
    /// Device kind (BLOCK_KIND_*, `mind::block::KIND_RAM` for the RAM disk), to tell drives apart.
    kind: func() -> u8;
    /// Lends the client's transfer buffer (up to BLOCK_MAX_SECTORS sectors) to this driver instance; the driver writes
    /// read data into it, the client reads it after the reply.
    attach: func(buffer: borrow<memory>) -> result<_, error-code>;
    /// Reads `count` sectors from `lba` into the attached buffer; returns the sectors read. Error not-found: no buffer is
    /// attached to this instance (the driver was restarted), invalid: past the end or an empty request, io: the drive
    /// failed or did not answer (1.3).
    read: func(count: u16, lba: u64) -> result<u16, error-code>;
    /// Whether this client may write: the medium is not write-protected and the client's capability carries the write
    /// badge (`mind::block::BADGE_WRITE`; init gives it to vfs_server only, Appendix B.6) (1.1).
    writable: func() -> bool;
    /// Writes `count` sectors to `lba` from `data`, sealed read-only memory (SHARE_RO: nobody can change it while the
    /// driver writes it) of at least `count` sectors; returns the sectors written. Errors: rights (no write badge, or the
    /// medium is write-protected), invalid (the memory is not sealed or too small, past the end, an empty request) (1.1),
    /// io (the drive failed or did not answer) (1.3).
    write: func(data: own<memory>, count: u16, lba: u64) -> result<u16, error-code>;
    /// Empties the drive's write cache; error rights without the write badge (1.1), io when the drive fails it (1.3).
    flush: func() -> result<_, error-code>;
    /// Window `index` (1 to 7) is the `count` sectors from `first` (1.2, 307-DRV-0054); set again, it moves. A window
    /// holds at most 2^32 sectors (2 TiB), as many as the block store addresses. Only the client badged
    /// `mind::block::BADGE_WINDOWS`, `init`'s own, may: rights for any other, named in the log; invalid for an index out
    /// of range, a count of 0, or a range past the device; not-found without a drive.
    window: func(index: u8, count: u32, first: u64) -> result<_, error-code>;
}
