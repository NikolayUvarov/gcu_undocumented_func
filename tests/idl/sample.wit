/// Test interface for the MIND IDL generator (tests/idl_host.rs): every v0.2 type.
package mind:sample@2.1.0;

interface sample {
    /// Why a call failed.
    enum error { not-found, exists, too-big }
    enum kind { file, directory, device }
    /// A directory entry.
    record entry {
        name: string<32>,
        size: u64,
        hidden: bool,
        kind: kind,
    }
    record pair { tag: u8, entry: entry }

    /// Scalars only, as in v0.
    ping: func(x: u32, flag: bool) -> u32;
    /// A string argument and a fallible scalar result.
    find: func(dir: u32, buffer: borrow<memory>, name: string<64>) -> result<u32, error>;
    /// A list of records as the result.
    list: func(buffer: borrow<memory>, start: u32) -> list<entry, 16>;
    /// Two bulk arguments and a result without a value.
    put: func(buffer: borrow<memory>, items: list<u16, 8>, note: bytes<10>) -> result<_, error>;
    /// A nested record result.
    info: func(buffer: borrow<memory>, of: kind) -> pair;
    /// An enum argument and an optional result.
    mode: func(k: kind) -> option<u8>;
}
